# Podman quadlet for the chunkserver on root@10.192.1.25 (nas)
# Install: copy to /etc/containers/systemd/mfschunkserver.container
#          then `systemctl daemon-reload && systemctl start mfschunkserver`
[Unit]
Description=MooseFS chunkserver (c2rust port)
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/mfs-rust:4.59.2
ContainerName=mfschunkserver
Network=host
Environment=ROLE=mfschunkserver
Environment=MASTER_HOST=10.10.0.1
Environment=HDD_PATHS=/mnt/hdd/mfs
Volume=/var/lib/mfschunkserver:/var/lib/mfs
Volume=/mnt/hdd/mfs:/mnt/hdd/mfs

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
