# Podman quadlet for the FUSE client mount on root@10.192.1.25 (nas)
# Install: copy to /etc/containers/systemd/mfsmount.container
#          then `systemctl daemon-reload && systemctl start mfsmount`
[Unit]
Description=MooseFS FUSE mount (c2rust port)
After=network-online.target mfschunkserver.service
Wants=network-online.target
[Container]
Image=docker.io/library/mfs-rust:4.59.2
ContainerName=mfsmount
Network=host
Environment=ROLE=mfsmount
Environment=MASTER_HOST=10.10.0.1
Environment=MOUNTPOINT=/mnt/plfs
AddDevice=/dev/fuse
AddCapability=SYS_ADMIN
Volume=/mnt/plfs:/mnt/plfs:rshared
[Service]
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
