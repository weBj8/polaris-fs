# Podman quadlet example for a FUSE client mount
# Install under /etc/containers/systemd/plfs/, then run:
# `systemctl daemon-reload && systemctl start plfsmount`
[Unit]
Description=PolarisFS FUSE mount
After=network-online.target plfschunkserver.service
Wants=network-online.target
[Container]
Image=ghcr.io/webj8/polaris-fs:latest
ContainerName=plfsmount
Network=host
Environment=ROLE=plfsmount
Environment=MASTER_HOST=192.168.1.1
Environment=MOUNT_POINT=/mnt/plfs
AddDevice=/dev/fuse
AddCapability=SYS_ADMIN
Volume=/mnt/plfs:/mnt/plfs:rshared
[Service]
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
